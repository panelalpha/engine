FROM {{ image }} AS builder
WORKDIR /app
RUN {{ git_install }}
{{ install_layer }}
{{ env }}
{{# build_command }}
RUN {{ build_command }}
{{/ build_command }}

FROM {{ nginx_image }}
COPY {{ nginx_conf }} /etc/nginx/conf.d/default.conf
COPY --from=builder /app/{{ output_directory }} /usr/share/nginx/html
EXPOSE 80
