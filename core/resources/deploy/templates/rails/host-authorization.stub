# frozen_string_literal: true
{{# host }}
# Written by PanelAlpha Engine for the configured reverse-proxy hostname.
# An empty config.hosts already accepts every Host; only extend a whitelist
# the application chose to keep.

Rails.application.config.after_initialize do
  hosts = Rails.application.config.hosts
  hosts << {{ host }} unless hosts.empty? || hosts.include?({{ host }})
end
{{/ host }}
