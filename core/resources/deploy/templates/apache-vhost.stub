# Generated by PanelAlpha - do not edit.
#
# DocumentRoot is read from the environment because whether an app serves from
# public/ is only settled when the container starts: the Node asset stage can
# create public/ after this file is written, and an overlay can move it. The
# start command exports PA_DOCROOT, and Apache expands ${...} from its own
# environment, the same way Debian's own config reads ${APACHE_RUN_USER}.

ServerName localhost

# Nothing outside the document root is web content, whatever a symlink or an
# Alias might suggest.
<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Directory "${PA_DOCROOT}">
    Options -Indexes +FollowSymLinks
    # The reason this file exists. A PHP application's directory protection is
    # written in .htaccess: Matomo generates them for config/, tmp/, lang/,
    # core/ and vendor/ at install time, and Laravel's public/.htaccess is its
    # front controller. A server that ignores them serves the lot.
    AllowOverride All
    Require all granted
</Directory>

# .git, .env and the rest are never web content, and the applications that deny
# them do it in .htaccess files they only write once installed. This holds from
# the first request. .well-known stays reachable: it is the one dot-path that
# is meant to be.
<DirectoryMatch "/\.(?!well-known)">
    Require all denied
</DirectoryMatch>
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# The engine's own files sit in the document root next to the application, and
# neither is ever a page. The generated compose file names the base image, the
# account's uid, the published ports and every environment variable the project
# was given -- on a project that passed a secret in env_vars, that is the
# variable's name published to anyone who asks. nginx-site.stub has denied
# these since it was written; this is the same rule for the Apache path, where
# a flat-PHP app serving from the repository root put both of them one request
# away.
<FilesMatch "^(?:docker-compose\.ya?ml|panelalpha[-.])">
    Require all denied
</FilesMatch>

# Logs go to the container's own streams, so `docker logs` and the deploy log
# show requests without a volume or a logrotate rule.
ErrorLog /dev/stderr
TransferLog /dev/stdout

<VirtualHost *:{{ port }}>
    DocumentRoot "${PA_DOCROOT}"
</VirtualHost>
